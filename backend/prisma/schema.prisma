// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RSVP {
  id           Int      @id @default(autoincrement())
  name         String
  email        String?
  attending    Boolean
  mealChoice   String?
  createdAt    DateTime @default(now())
}
