{
  "compilerOptions": {
    /* Basic Options */
    "target": "ES2020",                         // modern JS output
    "module": "CommonJS",                       // ✅ works perfectly with ts-node-dev
    "moduleResolution": "node",                 // resolves modules the standard Node way
    "rootDir": "src",
    "outDir": "dist",

    /* Interop and Type Safety */
    "esModuleInterop": true,                    // lets you use "import express from 'express'"
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,

    /* Misc */
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
